{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "color": "#fcf9f8", "name": "Background", "slug": "background" },
				{ "color": "#1b1b1b", "name": "On background", "slug": "on-background" },
				{ "color": "#440050", "name": "Primary", "slug": "primary" },
				{ "color": "#ffffff", "name": "On primary", "slug": "on-primary" },
				{ "color": "#660476", "name": "Primary container", "slug": "primary-container" },
				{ "color": "#e07fea", "name": "On primary container", "slug": "on-primary-container" },
				{ "color": "#a14000", "name": "Secondary", "slug": "secondary" },
				{ "color": "#ffffff", "name": "On secondary", "slug": "on-secondary" },
				{ "color": "#192900", "name": "Tertiary", "slug": "tertiary" },
				{ "color": "#294100", "name": "Tertiary container", "slug": "tertiary-container" },
				{ "color": "#7ab500", "name": "On tertiary container", "slug": "on-tertiary-container" },
				{ "color": "#b2f746", "name": "Tertiary fixed", "slug": "tertiary-fixed" },
				{ "color": "#121f00", "name": "On tertiary fixed", "slug": "on-tertiary-fixed" },
				{ "color": "#f6f3f2", "name": "Surface container low", "slug": "surface-container-low" },
				{ "color": "#eae7e7", "name": "Surface container high", "slug": "surface-container-high" },
				{ "color": "#ffffff", "name": "Surface lowest", "slug": "surface-container-lowest" },
				{ "color": "#50434f", "name": "On surface variant", "slug": "on-surface-variant" },
				{ "color": "#d3c1d0", "name": "Outline variant", "slug": "outline-variant" }
			]
		},
		"layout": {
			"contentSize": "768px",
			"wideSize": "1280px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "name": "Tiny", "size": "0.5rem", "slug": "20" },
				{ "name": "Small", "size": "1rem", "slug": "30" },
				{ "name": "Gutter", "size": "1.5rem", "slug": "40" },
				{ "name": "Section", "size": "3rem", "slug": "50" },
				{ "name": "Large", "size": "4rem", "slug": "60" },
				{ "name": "X-Large", "size": "6rem", "slug": "70" }
			],
			"units": ["%", "px", "em", "rem", "vh", "vw"]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{ "fluid": false, "name": "Small", "size": "0.875rem", "slug": "small" },
				{ "name": "Medium", "size": "1rem", "slug": "medium", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "name": "Large", "size": "1.25rem", "slug": "large", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "name": "Extra Large", "size": "1.75rem", "slug": "x-large", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "name": "Huge", "size": "3rem", "slug": "xx-large", "fluid": { "min": "2.25rem", "max": "3.75rem" } }
			],
			"fontFamilies": [
				{
					"name": "Plus Jakarta Sans",
					"slug": "plus-jakarta-sans",
					"fontFamily": "\"Plus Jakarta Sans\", sans-serif"
				},
				{
					"name": "Montserrat",
					"slug": "montserrat",
					"fontFamily": "Montserrat, sans-serif"
				}
			]
		},
		"useRootPaddingAwareAlignments": false
	},
	"styles": {
		"color": {
			"background": "var:preset|color|background",
			"text": "var:preset|color|on-background"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|plus-jakarta-sans",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|montserrat",
					"fontWeight": "700"
				},
				"color": {
					"text": "var:preset|color|primary"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|secondary"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|primary"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|on-primary"
				},
				"border": {
					"radius": "20px"
				},
				"typography": {
					"fontWeight": "600",
					"fontSize": "0.875rem"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "0.875rem",
					"fontWeight": "500"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|montserrat",
					"fontWeight": "700"
				}
			},
			"core/button": {
				"border": {
					"radius": "20px"
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontWeight": "600"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-como-funciona", "title": "Cómo funciona", "postTypes": ["page"] },
		{ "name": "page-noticias", "title": "Noticias", "postTypes": ["page"] },
		{ "name": "page-eventos", "title": "Eventos", "postTypes": ["page"] },
		{ "name": "page-fotos", "title": "Fotos", "postTypes": ["page"] },
		{ "name": "page-bdtescolar", "title": "BdTescolar", "postTypes": ["page"] },
		{ "name": "front-template", "title": "BdT Front Template", "postTypes": ["page"] },
		{ "name": "logged-template", "title": "BdT Logged Template", "postTypes": ["page"] },
		{ "name": "content-template", "title": "BdT Content Template", "postTypes": ["page"] },
		{ "name": "management-template", "title": "BdT Management Template", "postTypes": ["page"] }
	]
}
